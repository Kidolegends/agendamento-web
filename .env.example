# Base URL used by the browser to reach the API.
# In dev, Vite proxies "/api" to the API (see vite.config.ts). In Docker, nginx does it.
VITE_API_URL=/api

# Time zone used to display dates (must match BUSINESS_UTC_OFFSET of the API).
VITE_TIMEZONE=America/Sao_Paulo

# Only for `npm run dev`: where the API is running.
API_PROXY_TARGET=http://localhost:3333
